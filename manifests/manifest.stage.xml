<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>d913b3fe-90e7-4bc9-86d2-d391ea0a7fd1</Id>
  <Version>1.0.0.3</Version>
  <ProviderName>OpenLegalCore</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="OpenLegalCore for Word (Staging)">
    <Override Locale="sl-SI" Value="OpenLegalCore za Word (Staging)"/>
  </DisplayName>
  <Description DefaultValue="Staging Microsoft Word connector for OpenLegalCore.">
    <Override Locale="sl-SI" Value="Dodatek OpenLegalCore za Microsoft Word (Staging)."/>
  </Description>
  <IconUrl DefaultValue="https://word-staging.example.invalid/assets/office/1.0.0.2/openlegalcore-mark-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://word-staging.example.invalid/assets/office/1.0.0.2/openlegalcore-mark-64.png"/>
  <SupportUrl DefaultValue="https://github.com/OpenLegalCore/olc-word-connector"/>
  <AppDomains>
    <AppDomain>https://github.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="WordApi" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://word-staging.example.invalid/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://word-staging.example.invalid/assets/office/1.0.0.2/openlegalcore-mark-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://word-staging.example.invalid/assets/office/1.0.0.2/openlegalcore-mark-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://word-staging.example.invalid/assets/office/1.0.0.2/openlegalcore-mark-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <bt:Url id="Commands.Url" DefaultValue="https://word-staging.example.invalid/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://word-staging.example.invalid/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="OpenLegalCore for Word is ready">
          <bt:Override Locale="sl-SI" Value="OpenLegalCore za Word (Staging) je pripravljen"/>
        </bt:String>
        <bt:String id="CommandsGroup.Label" DefaultValue="OpenLegalCore"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Open OpenLegalCore">
          <bt:Override Locale="sl-SI" Value="Odpri OpenLegalCore"/>
        </bt:String>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="The connector is ready. Open the task pane from the Home tab.">
          <bt:Override Locale="sl-SI" Value="Dodatek je pripravljen. Odprite podokno na zavihku Osnovno."/>
        </bt:String>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open the OpenLegalCore task pane">
          <bt:Override Locale="sl-SI" Value="Odpri podokno OpenLegalCore"/>
        </bt:String>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>

