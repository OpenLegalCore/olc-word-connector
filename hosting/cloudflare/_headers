/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' https://appsforoffice.microsoft.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://login.microsoftonline.com; frame-src 'self' https://login.microsoftonline.com https://login.live.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self' https://word.cloud.microsoft https://inclient.store.office.com https://*.officeapps.live.com;

/manifest.xml
  Cache-Control: no-cache
  Content-Type: application/xml; charset=UTF-8

/*.html
  Cache-Control: no-cache
  Content-Type: text/html; charset=UTF-8

/assets/office/1.0.0.2/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

/*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/javascript; charset=UTF-8

/*.css
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css; charset=UTF-8

/microsoft-redirect.html
  Cache-Control: no-store

/microsoft-signin.html
  Cache-Control: no-store

/taskpane.html
  Cache-Control: no-store
